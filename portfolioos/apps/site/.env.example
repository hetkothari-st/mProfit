# Public URL of this marketing site (used for canonical links and sitemap.xml)
VITE_SITE_URL=https://everypaisa.in
# The EveryPaisa web app. "Start free" and "Sign in" point here.
VITE_APP_URL=https://portfolio-os.up.railway.app
# Address shown on the contact page and used as the mail fallback
VITE_CONTACT_EMAIL=everypaisa.admin@gmail.com
# Optional: a form endpoint that accepts JSON POSTs (Formspree, Basin, your own API).
# When empty, the contact form opens the visitor's mail app instead.
VITE_CONTACT_ENDPOINT=
