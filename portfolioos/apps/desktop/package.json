{
  "name": "@everypaisa/desktop",
  "productName": "EveryPaisa",
  "version": "1.0.0",
  "private": true,
  "description": "EveryPaisa desktop app",
  "author": "EveryPaisa",
  "homepage": "https://portfolio-os.up.railway.app",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "dist": "node build.mjs && electron-builder --publish never",
    "release": "node build.mjs && electron-builder --publish always"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "esbuild": "0.28.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
