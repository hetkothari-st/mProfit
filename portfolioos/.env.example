# ─── Database ─────────────────────────────────────────────
# Two roles, on purpose.
#
# DATABASE_URL is what the app runs as. It MUST be portfolioos_app
# (NOSUPERUSER NOBYPASSRLS). A superuser or a managed provider's owner role
# (e.g. neondb_owner) bypasses Row-Level Security completely, and every tenant
# isolation policy in prisma/migrations becomes a no-op. Verify in production:
#   SELECT current_user, rolsuper, rolbypassrls FROM pg_roles
#   WHERE rolname = current_user;
# must return: portfolioos_app | f | f
#
# DIRECT_URL is for `prisma migrate` only, which needs DDL rights.
#
# The portfolioos_app password below is the dev value from the migration.
# Change it before any shared deployment:
#   ALTER ROLE portfolioos_app WITH PASSWORD '<from your secret store>';
DATABASE_URL=postgresql://portfolioos_app:portfolioos_app_dev@localhost:5432/portfolioos
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/portfolioos

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── Email (for alerts / password reset) ─────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SMTP_FROM="EveryPaisa <no-reply@portfolioos.in>"

# ─── Price data ───────────────────────────────────────────
NSE_API_KEY=
AMFI_NAV_URL=https://www.amfiindia.com/spages/NAVAll.txt

# ─── Storage ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ─── App ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ─── Encryption (PF auto-fetch credentials, identifiers) ──
# 32 random bytes, base64-encoded. Generate via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production, source from a secret manager (AWS Parameter Store / similar) — never commit.
APP_ENCRYPTION_KEY=

# ─── Observability ───────────────────────────────────────
# Sentry DSN for error tracking and performance tracing. Leave empty to disable.
# Get from https://sentry.io → project settings → Client Keys.
SENTRY_DSN=

# ─── Web (Vite) ───────────────────────────────────────────
VITE_API_URL=http://localhost:3001

# ─── Secrets that production refuses to boot without ─────
# Each of these used to fail OPEN when unset. config/env.ts now exits.
#
# Encrypts broker keys/secrets/TOTP seeds, OAuth tokens, mailbox passwords.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=
# Must match JWT_SECRET on the OnlyOffice DocumentServer container. Signs the
# tokens that authorise document downloads — the placeholder is public.
ONLYOFFICE_JWT_SECRET=
# HMAC secret for Account Aggregator webhooks, their only access control.
FINFACTOR_WEBHOOK_SECRET=
