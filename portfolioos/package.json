{
  "name": "everypaisa",
  "version": "0.1.0",
  "private": true,
  "description": "EveryPaisa — full-stack multi-asset portfolio management & accounting platform",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "dev:api": "pnpm --filter @everypaisa/api dev",
    "dev:web": "pnpm --filter @everypaisa/web dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:migrate": "pnpm --filter @everypaisa/api exec prisma migrate dev",
    "db:generate": "pnpm --filter @everypaisa/api exec prisma generate",
    "db:seed": "pnpm --filter @everypaisa/api exec prisma db seed",
    "db:studio": "pnpm --filter @everypaisa/api exec prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "preinstall": "npx --yes only-allow pnpm"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-everypaisa": "workspace:*",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "prettier": "^3.3.3",
    "prisma": "5.22.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": "^2.0.8",
      "tmp": "^0.2.6",
      "form-data@>=4": "^4.0.6",
      "undici@>=7": "^7.29.1",
      "linkify-it": "^5.0.2",
      "ip-address": "^10.3.1",
      "lodash": "^4.18.0",
      "brace-expansion@<2": "^1.1.20",
      "brace-expansion@>=2 <3": "^2.1.6",
      "brace-expansion@>=4": "^5.0.11",
      "postcss": "^8.5.18",
      "nanoid@<4": "^3.3.18",
      "source-map-js": "^1.2.2",
      "nodemailer": "^10.0.15"
    }
  }
}
